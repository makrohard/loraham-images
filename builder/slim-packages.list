# Desktop image slimming — optional applications the appliance does not need.
# Format: <variant> <action> <target...>          # comment
#   variant : desktop | lite | both   (only the built variant's lines are considered)
#   action  : purge                   (apt-get purge, guarded — see slim.sh)
# One line per GROUP: a group is purged together or not at all, so a package whose
# removal orphans another (thonny -> python3-mypy) does not leave the orphan behind.
#
# Most of these are Recommends of installed Raspberry Pi meta packages (rpd-utilities,
# rpd-applications, rpd-x-extras); pocketsphinx-en-us is recommended by libavfilter10 instead.
# Either way a later `apt full-upgrade` on a DEPLOYED box may reinstall them. That is accepted and documented: the 2 GiB cap is a build-artifact
# problem, and an apt pin here could turn a future Recommends->Depends promotion into
# an unsatisfiable upgrade on machines in the field.
# NEVER add chrony or gpsd, or anything they pull. They ARE the box's time source: the controller
# installs both by default, and installing chrony REMOVES systemd-timesyncd, so between them they
# are the only way a Pi learns the time after a power cut — it has no RTC. Opting out is a
# bootstrap decision (--no-time-source), never a slimming one. Check the image's own package list
# before concluding this line has gone stale.
desktop purge rpi-userguide                   # the beginners' book; it is online
desktop purge rpi-imager                      # writes SD cards — done on a PC, not on the device
desktop purge firefox                         # second browser; x-www-browser is chromium
desktop purge realvnc-vnc-server              # wayvnc ships too and is the supported path
desktop purge thonny python3-mypy mypy        # Python IDE + its type checker (mypy orphans otherwise)
desktop purge pocketsphinx-en-us              # offline speech model, a Recommends of libavfilter10
