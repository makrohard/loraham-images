# loraham-images - Desktop variant (graphical desktop, DHCP client)
# KEY=VALUE only. No inline comments (the parser takes the whole line after = as the value).
# Base URL/sha are RESOLVED at build time (builder/resolve-base.sh).

VARIANT=desktop

# Raspberry Pi OS DESKTOP stream (raspios_arm64 = with-desktop, NOT _full, NOT _lite).
BASE_STREAM=raspios_arm64


# bootstrap-deps.sh GUI flag: --with-gui on Desktop (installs voice/nodegui/sideband).
BOOTSTRAP_GUI=--with-gui

# Networking / exposure / SSH policy.
# WIFI_MODE=client (joins your network — no AP, and so no recovery AP) ; EXPOSE_SCOPE=none.
WIFI_MODE=client
EXPOSE_SCOPE=none
# Full-stack box: the console stays loopback-only and the stacks are NOT exposed — their
# proxies are bound to 127.0.0.1 so the dashboard can link them (MeshCom's UI is otherwise
# unreachable even locally: QEMU forwards it to loopback and lhpc will not link a dead
# 127.0.0.1 URL). The managed firewall is on, and SSH is reachable on every interface.
PROXY_MODE=local
SSH_ENABLE=on

# Wi-Fi power-save disable drop-in: Desktop off.
WIFI_POWERSAVE_DISABLE=0

# Temporary build-time filesystem growth (MiB appended before provisioning).
GROW_MB=8192
