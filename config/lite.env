# loraham-images - Lite variant (headless, Wi-Fi access-point onboarding)
# KEY=VALUE only. No inline comments (the parser takes the whole line after = as the value).
# Base URL/sha are RESOLVED at build time (builder/resolve-base.sh); the *_REF values below
# are the known-current first-build reference, verified before use.

VARIANT=lite

# Raspberry Pi OS image STREAM on downloads.raspberrypi.com.
BASE_STREAM=raspios_lite_arm64

# Known-current first-build reference (NOT a permanent pin).
BASE_URL_REF=https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2026-06-19/2026-06-18-raspios-trixie-arm64-lite.img.xz
BASE_SHA256_REF=acff736ca7945e3b305f07cda4abdb870910e12634991da69783611756e381b3

# bootstrap-deps.sh GUI flag: empty on Lite (headless).
BOOTSTRAP_GUI=

# Networking / exposure / SSH policy.
# WIFI_MODE=ap ; EXPOSE_SCOPE=ap (console no-auth, restricted to the AP CIDR) ; SSH_POLICY=ap-only.
WIFI_MODE=ap
EXPOSE_SCOPE=ap
SSH_POLICY=ap-only

# Wi-Fi power-save disable drop-in (Zero 2 W AP stability). Lite: on.
WIFI_POWERSAVE_DISABLE=1

# Temporary build-time filesystem growth (MiB appended before provisioning).
GROW_MB=6144
