# loraham-images — onboarding defaults (SINGLE SOURCE OF TRUTH)
#
# Every user-facing reference (README, /boot/firmware/README.txt, MOTD) is generated
# from THIS file so docs and implementation cannot drift (docs/first-steps.src.md is
# rendered with these values substituted).
#
# These are INTENTIONAL PUBLIC ONBOARDING DEFAULTS, not secrets. They exist so a Lite
# image works the instant it is flashed. They MUST be changed after commissioning; they
# are for local commissioning, not permanent secure operation. The console is not exposed
# to the ordinary LAN or the Internet by default.
#
# Only KEY=VALUE lines, no shell expansion — sourced with a strict parser.

# Operator account baked into the image (sole operator; created at build).
OPERATOR_USER=lhpc
OPERATOR_PASSWORD=lhpc

# Hostname and AP SSID carry a per-device suffix (4 hex from the CPU serial):
#   hostname -> lhpc-<suffix> , AP SSID -> lhpc-<suffix>
HOSTNAME_BASE=lhpc
AP_SSID_BASE=lhpc

# AP pre-shared key — WPA2, must be >= 8 characters. Documented shared default.
AP_PSK=lorahampi

# Wi-Fi regulatory domain. The #1 reason an AP won't start is an unset country.
# Users outside Germany must override WIFI_COUNTRY (lhpc-config.txt) and set their
# correct regulatory domain before normal radio/Wi-Fi operation.
WIFI_COUNTRY=DE

# Fixed AP network (NetworkManager ipv4.method shared => the Pi is 10.42.0.1).
AP_ADDR=10.42.0.1
AP_PREFIX=24
AP_CIDR=10.42.0.0/24

# Console (nginx TLS front end).
CONSOLE_PORT=8443

# Low-memory swap restored at first boot (upstream default).
SWAP_MB=768
SWAP_FILE=/var/swap.lhpc
