# loraham-images — onboarding defaults (SINGLE SOURCE OF TRUTH)
#
# Every user-facing reference (README, /boot/firmware/README.txt, MOTD) is generated
# from THIS file so docs and implementation cannot drift (docs/first-steps.src.md is
# rendered with these values substituted).
#
# These are INTENTIONAL PUBLIC ONBOARDING DEFAULTS, not secrets. They exist so a Lite
# image works the instant it is flashed. They MUST be changed after commissioning; they
# are for local commissioning, not permanent secure operation. The console is not exposed
# to the ordinary LAN or the Internet by default.
#
# Only KEY=VALUE lines, no shell expansion — sourced with a strict parser.

# Operator account baked into the image (sole operator; created at build).
OPERATOR_USER=lhpc
OPERATOR_PASSWORD=lhpc

# Hostname and AP SSID carry a per-device suffix (4 hex from the CPU serial):
#   hostname -> lhpc-<suffix> , AP SSID -> lhpc-<suffix>
HOSTNAME_BASE=lhpc
AP_SSID_BASE=lhpc

# AP pre-shared key — WPA2, must be >= 8 characters. Documented shared default.
AP_PSK=lorahampi

# SSID of the FALLBACK AP raised only while first boot has not completed (a failed rootfs
# expansion, an invalid lhpc-config.txt, any pre-AP step failing). Deliberately distinct
# from AP_SSID_BASE so a broken box is identifiable on sight; same key as AP_PSK.
RECOVERY_SSID_BASE=lhpc-recovery

# System timezone. The base image ships Europe/London; without this every flashed box
# reports UK local time, which is wrong for the region WIFI_COUNTRY declares. Override in
# lhpc-config.txt with any zone name from /usr/share/zoneinfo (e.g. America/New_York).
TIMEZONE=Europe/Berlin

# Wi-Fi regulatory domain. The #1 reason an AP won't start is an unset country.
# Users outside Germany must override WIFI_COUNTRY (lhpc-config.txt) and set their
# correct regulatory domain before normal radio/Wi-Fi operation.
WIFI_COUNTRY=DE

# Fixed AP network (NetworkManager ipv4.method shared => the Pi is 10.42.0.1).
AP_ADDR=10.42.0.1
AP_PREFIX=24
AP_CIDR=10.42.0.0/24

# Console (nginx TLS front end).
CONSOLE_PORT=8443

# Stack web UIs proxied at first boot, reachable ON THE AP ONLY and WITHOUT authentication —
# the same posture the console itself ships with (EXPOSE_SCOPE=ap). Only stacks with an HTTP
# upstream can be proxied; the rest speak non-HTTP protocols. MeshCom is the reason this
# exists: QEMU forwards its UI to 127.0.0.1 only, so a proxy is the ONLY way to reach it.
# Ports are CONSOLE_PORT+1+index in this list. Set empty to proxy nothing. COMMA-separated
# and space-free on purpose: ci-assert.sh SOURCES this file, and `KEY=a b` would run `b`.
PROXY_STACKS=meshcom,meshtastic

# Managed nftables firewall applied at first boot. secure-default DENIES the stacks' own
# native ports (e.g. meshtasticd's 9443) so the proxies above are the only way in, while SSH
# stays reachable on EVERY interface — the firewall resolves sshd's effective listeners and
# refuses to narrow them, so a locked-out box is not possible here.
FIREWALL=on

# Low-memory swap restored at first boot (upstream default).
SWAP_MB=768
SWAP_FILE=/var/swap.lhpc
