[Unit]
Description=loraham-images first boot (onboarding: hostname, AP, device PKI, console)
# Run only until it has completed once.
ConditionPathExists=!/var/lib/lhpc/.firstboot-done
# Root expansion is a HARD prerequisite: lhpc-growroot.service must succeed first, or firstboot
# must not start (and not write to an unexpanded filesystem). Requires= propagates its failure;
# After= orders us after it. (Before= alone only orders, it does not propagate failure.)
Requires=lhpc-growroot.service
After=lhpc-growroot.service
# Also after NetworkManager + user sessions. firstboot BRINGS UP the network (the AP) itself, so
# it must NOT wait for network-online.target — an AP-only field box has no upstream and would hang.
After=NetworkManager.service systemd-user-sessions.target
DefaultDependencies=yes

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/lhpc-firstboot
# Stays armed on failure (no .firstboot-done written); retried on the next boot.
TimeoutStartSec=1200

[Install]
WantedBy=multi-user.target
